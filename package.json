{
  "name": "notification-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply notification-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply notification-db --remote",
    "setup:dev": "node scripts/generate-vapid-keys.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.3.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.0",
    "wrangler": "^4.147.0"
  },
  "dependencies": {
    "hono": "^4.13.13",
    "web-push-neo": "^0.1.2",
    "zod": "^4.6.5"
  }
}
